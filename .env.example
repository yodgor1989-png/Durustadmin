# --- Telegram ---------------------------------------------------------------
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenHereReplaceMe
# Kunlik hisobot yuboriladigan guruh ID (bot guruhda admin bo'lishi kerak)
GROUP_CHAT_ID=-1001234567890
# Notion'ni o'zgartira oladigan Telegram ID'lar (vergul bilan). Bo'sh = hamma.
ADMIN_IDS=

# --- Notion -----------------------------------------------------------------
# https://www.notion.so/my-integrations dan "Internal Integration Secret"
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Baza ID: Notion'da bazani oching, URL dagi uzun hex qism
# notion.so/<workspace>/<BAZA_ID>?v=...
NOTION_DATABASE_ID=
# Bo'sh bo'lsa bot bazani shu nom bo'yicha qidiradi
DATABASE_TITLE_HINT=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.5

# --- Qoida sozlamalari ------------------------------------------------------
# Zadacha nomi kamida shuncha so'zdan iborat bo'lsin
MIN_TITLE_WORDS=3
# "Стрт" statusida shuncha kundan ko'p qotib qolsa - ogohlantirish
STALE_DAYS=7
# Kunlik hisobot vaqti
REPORT_HOUR=9
REPORT_MINUTE=0
TIMEZONE=Asia/Tashkent
# Notion sahifalariga komentariya yozilsinmi (false = faqat Telegram'da)
WRITE_TO_NOTION=true
